# Auto detect text files and perform LF normalization
* text=auto
# 리눅스 셸 스크립트는 LF 그대로(CRLF 면 bash 가 '\r' 로 깨진다), 윈도 배치는 CRLF
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
# 바이너리
*.png binary
*.jpg binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.hwpx binary
