# /etc/logtriage/server.env — LogTriage 서버형 환경설정 (systemd EnvironmentFile)
# 앱(WAS)은 nginx 뒤에서만 받도록 루프백에 바인딩한다. nginx 없이 직접 노출하려면 0.0.0.0 으로.
LOGTRIAGE_HOST=127.0.0.1
LOGTRIAGE_PORT=8088

# 접속 비밀번호(비우면 인증 없음 — 내부망 전용일 때만). 설정 시 브라우저 접속 때 로그인 화면
LOGTRIAGE_PASSWORD=change-me

# 저장소(DBMS) — install.sh 가 선택에 맞게 채운다
#   PostgreSQL : postgresql://logtriage:<비밀번호>@127.0.0.1:5432/logtriage
#   SQLite     : sqlite:////opt/logtriage/data/logtriage.db   (단일 파일, 추가 설치 없음)
LOGTRIAGE_DB=sqlite:////opt/logtriage/data/logtriage.db

# 서버 로컬 로그 디렉터리를 화면에서 직접 고르게 하려면 --allow-dir 를 나열 (여러 개 가능)
LOGTRIAGE_ALLOW=--allow-dir /var/log --allow-dir /data/logs

# 업로드 원본(개인정보 포함 가능) 보존 일수 — logtriage-cleanup.timer 가 매일 초과분 삭제
LOGTRIAGE_UPLOAD_KEEP_DAYS=14

# 12차 병렬 해석: 합계 32MB 이상 로그는 CPU 수(최대 16)만큼 작업자 프로세스로 나눠 해석한다(판정은 순차와 같음).
# 작업자 수는 min(MemAvailable, 이 서비스의 MemoryMax − 사용량) 의 60% / 64MB 를 넘지 않게 자동으로 줄어든다.
# 고정하려면 숫자(1 = 순차). 비우면 자동.
#LOGTRIAGE_WORKERS=
