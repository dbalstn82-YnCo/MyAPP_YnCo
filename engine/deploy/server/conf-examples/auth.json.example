{
  "_설명": "이 파일을 <설치경로>/conf/auth.json 으로 복사하고 portal.method 하나를 고른 뒤 서비스를 다시 시작합니다. _ 로 시작하는 항목은 무시됩니다.",
  "mode": "portal",
  "session_idle_min": 60,
  "session_max_hours": 12,
  "default_role": "viewer",
  "default_sites": [],
  "auto_create": true,
  "require_https": true,
  "_require_https": "true(기본): 127.0.0.1 직접 접속 또는 같은 서버 nginx(TLS)가 X-Forwarded-Proto=https 를 붙인 요청만 허용. TLS 앞단이 없는 Windows 설치형 서버 모드는 false 로 두고 사내망 구간 보호를 따로 확인",
  "portal": {
    "method": "ldap",
    "label": "통합 계정",
    "portal_url": "",
    "logout_url": "",
    "ldap": {
      "url": "ldaps://ad.example.local:636",
      "bind_dn_format": "{login}@example.local",
      "search_base": "DC=example,DC=local",
      "login_attr": "sAMAccountName",
      "timeout": 5,
      "verify_tls": true,
      "ca_file": ""
    },
    "oidc": {
      "authorize_url": "https://sso.example.local/realms/corp/protocol/openid-connect/auth",
      "token_url": "https://sso.example.local/realms/corp/protocol/openid-connect/token",
      "jwks_url": "https://sso.example.local/realms/corp/protocol/openid-connect/certs",
      "issuer": "https://sso.example.local/realms/corp",
      "client_id": "logtriage",
      "client_secret": "",
      "redirect_uri": "https://logtriage.example.local/sso/oidc/callback",
      "scope": "openid profile",
      "login_claim": "preferred_username"
    },
    "header": {
      "user_header": "X-Portal-User",
      "name_header": "X-Portal-Name",
      "dept_header": "X-Portal-Dept",
      "groups_header": "X-Portal-Groups",
      "trusted_proxies": [
        "127.0.0.1"
      ],
      "proxy_secret": "",
      "_설명": "trusted_proxies 는 반드시 앞단 웹서버 주소만(기본값 없음). proxy_secret 을 넣으면 앞단이 X-Proxy-Secret 헤더로 같은 값을 보내야 함"
    },
    "link": {
      "secret": "",
      "max_skew_sec": 120,
      "_설명": "secret 은 32자 이상 무작위 값 — python -m logtriage.auth --base <설치경로> gen-secret 으로 만들어 연동 시스템과 같은 값을 넣음"
    },
    "group_map": [
      {
        "group": "CN=IT운영",
        "role": "operator",
        "sites": [
          "*"
        ]
      },
      {
        "group": "CN=정보보안",
        "role": "admin",
        "sites": [
          "*"
        ]
      }
    ]
  }
}